<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	<Version>0.0.3.1</Version>
	<Authors>Randy Kreisel</Authors>
	<Company>House on the Rock Software</Company>
	<Description>
	  OpenAPI tools to enhance the Scalar UI
	</Description>
	<Copyright>Randy Kreisel 2026</Copyright>
	<PackageTags>Attributes and Transformers</PackageTags>
	<PackageReleaseNotes>Initial Release</PackageReleaseNotes>
	<PackageLicenseUrl></PackageLicenseUrl>
	<PackageId>HotRS.Tools.OpenAPI</PackageId>
	<PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authorization" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
  </ItemGroup>

</Project>
